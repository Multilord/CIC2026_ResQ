# Copy this file to server/local.env, which is ignored by Git.
# Set credentials locally; never put the Gemini key in Flutter or commit it.
GEMINI_API_KEY=
# Choose a generateContent + structured-output capable model available to your project.
GEMINI_MODEL=
RESQ_HOST=127.0.0.1
RESQ_PORT=4175
RESQ_ORIGINS=http://127.0.0.1:4174,http://localhost:4174
# Optional, used only when first creating the database:
# RESQ_ADMIN_EMAIL=admin@resq.local
# RESQ_ADMIN_PASSWORD=choose-a-long-unique-password
